# Docker settings for compose.yaml. Copy to .env and change what you need; each has a default.
# The SNMP configuration itself is mrtg.cfg (WorkDir: /var/lib/linkscope), not this file.

# Where the UI, the JSON API and /metrics are published on the host. The UI has no login: keep it
# on loopback or a management network, and list the name you open it by in WebHosts: in mrtg.cfg.
LINKSCOPE_LISTEN=127.0.0.1:8080

# The configuration file on the host (owned by root, group 10001, mode 640).
LINKSCOPE_CONFIG=./mrtg.cfg

# The image to run. `docker compose build` builds it from this repository instead.
LINKSCOPE_IMAGE=ghcr.io/rinjanianalytics/linkscope:0.3.0

# Cargo jobs when building the image here (lower on a small host).
CARGO_BUILD_JOBS=4
